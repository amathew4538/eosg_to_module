#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

def get_sufix():
    suffix = ".{}.{}".format(env["platform"], env["target"])
    suffix = suffix.replace("linuxbsd", "linux")
    if env.dev_build:
        suffix += ".dev"
    if env["precision"] == "double":
        suffix += ".double"
    suffix += "." + env["arch"]
    if not env["threads"]:
        suffix += ".nothreads"
    return suffix

platform = env["platform"].replace("linuxbsd", "linux")
arch = env["arch"]
suffix = get_sufix()

# 1. Link precompiled library using explicit file paths to prevent lookup failures
if platform == "macos":
    # Nested inside the .framework bundle as described in your folder scheme
    lib_path = "#modules/eosg/bin/addons/eosg/bin/macos/libeosg{}.framework/libeosg{}.a".format(suffix, suffix)
    env.Append(LIBS=[env.File(lib_path)])
else:
    lib_path = "#modules/eosg/bin/addons/eosg/bin/{}/libeosg{}.a".format(platform, suffix)
    env.Append(LIBS=[env.File(lib_path)])

# 2. Godot-cpp library path
godot_cpp_path = "#modules/eosg/ext/godot-cpp/bin/libgodot-cpp{}.a".format(suffix)
env.Append(LIBS=[env.File(godot_cpp_path)])

# 3. EOS SDK configuration
sdk_path = "#modules/eosg/sdk/{}/{}".format(platform, arch)
env.Append(CPPPATH=[sdk_path + "/Include"])

if platform in ["windows", "linux", "macos"]:
    env.Append(LIBPATH=[sdk_path + "/lib"])
    if platform == "windows":
        sdk_library = "EOSSDK-Win64-Shippingarm64" if arch == "arm64" else "EOSSDK-Win64-Shipping"
        env.Append(LIBS=[sdk_library])
    elif platform == "linux":
        env.Append(LIBS=["EOSSDK-LinuxArm64-Shipping" if arch == "arm64" else "EOSSDK-Linux-Shipping"])
    elif platform == "macos":
        env.Append(LIBS=["EOSSDK-Mac-Shipping"])
elif platform == "ios":
    env.Append(LINKFLAGS=[
        "-F", sdk_path + "/EOSSDK.xcframework/ios-arm64",
        "-framework", "AuthenticationServices",
        "-framework", "EOSSDK",
    ])
elif platform == "android":
    android_arch = "arm64-v8a" if arch == "arm64" else "x86_64"
    env.Append(LIBPATH=[sdk_path + "/Android/libs/" + android_arch])
    env.Append(LIBS=["EOSSDK"])

# 4. Sources collection
env_gdextension = env_modules.Clone()
env_gdextension.add_source_files(env.modules_sources, "*.cpp")
