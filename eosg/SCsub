#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

def get_sufix():
    suffix = ".{}.{}".format(env["platform"], env["target"])
    # In godot it's "linuxbsd"
    suffix = suffix.replace("linuxbsd", "linux")
    # Only take release
    suffix = suffix.replace("editor", "template_release")
    suffix = suffix.replace("template_debug", "template_release")
    if env.dev_build:
        suffix += ".dev"
    if env["precision"] == "double":
        suffix += ".double"
    suffix += "." + env["arch"]
    if not env["threads"]:
        suffix += ".nothreads"
    return suffix

# Libraries
if env["platform"] == "macos" or env["platform"] == "ios":
    base_path = "#modules/eosg/bin/addons/eosg/bin/libeosg{}.framework".format(get_sufix())
    base_file = "libeosg{}".format(get_sufix())
else:
    base_path = "#modules/eosg/bin/addons/eosg/bin"
    base_file = "libeosg{}".format(get_sufix())

env.Append(LIBS=[base_file])
env.Append(LIBPATH=[base_path])

# Godot-cpp
base_path = "#modules/eosg/ext/godot-cpp/bin"
base_file = "libgodot-cpp{}".format(get_sufix())

env.Append(LIBS=[base_file])
env.Append(LIBPATH=[base_path])

# EOS SDK
platform = env["platform"].replace("linuxbsd", "linux")
sdk_arch = env["arch"]

sdk_path = "#modules/eosg/sdk/{}/{}".format(platform, sdk_arch)
env.Append(CPPPATH=[sdk_path + "/Include"])
if platform in ["windows", "linux", "macos"]:
    env.Append(LIBPATH=[sdk_path + "/lib"])
    if platform == "windows":
        sdk_library = "EOSSDK-Win64-Shippingarm64" if env["arch"] == "arm64" else "EOSSDK-Win64-Shipping"
        env.Append(LIBS=[sdk_library])
    elif platform == "linux":
        env.Append(LIBS=["EOSSDK-LinuxArm64-Shipping" if env["arch"] == "arm64" else "EOSSDK-Linux-Shipping"])
    else:
        env.Append(LIBS=["EOSSDK-Mac-Shipping"])
elif platform == "ios":
    env.Append(LINKFLAGS=[
        "-F", sdk_path + "/EOSSDK.xcframework/ios-arm64",
        "-framework", "AuthenticationServices",
        "-framework", "EOSSDK",
    ])
elif platform == "android":
    android_arch = "arm64-v8a" if env["arch"] == "arm64" else "x86_64"
    env.Append(LIBPATH=[sdk_path + "/Android/libs/" + android_arch])
    env.Append(LIBS=["EOSSDK"])

# Sources
env_gdextension = env_modules.Clone()

env_gdextension.add_source_files(env.modules_sources, "*.cpp")
